DATABASE_URL=sqlite:///./crudfab.db
# PostgreSQL example:
# DATABASE_URL=postgresql://crudfab:crudfab@localhost:5432/crudfab

SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Session cookie (httpOnly)
SESSION_COOKIE_NAME=crudfab_session
SESSION_COOKIE_SECURE=false   # HTTPS uzerinden cikis icin true
SESSION_COOKIE_SAMESITE=lax   # lax | strict | none

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Seed defaults
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ENABLED=true
SEED_PERSON_COUNT=1000
